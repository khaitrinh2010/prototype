# Copy this file to .env and fill in the values.
# Never commit .env — it contains real secrets.

# ─── Next Auth ───────────────────────────────────────────────────────────────
# Generate with: npx auth secret  OR  openssl rand -base64 32
AUTH_SECRET=""

# ─── Google OAuth ────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
# Callback URL (local):  http://localhost:3000/api/auth/callback/google
# Callback URL (prod):   https://your-domain.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Anthropic ───────────────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""

# ─── PostgreSQL (Supabase / Neon) ────────────────────────────────────────────
# DATABASE_URL  → pooled connection string (used by the app at runtime)
# DIRECT_URL    → direct connection string (used by Prisma migrations only)
#
# Supabase: Settings → Database → Connection string
#   Pooled  → Transaction mode  (port 6543) → DATABASE_URL
#   Direct  → Session mode      (port 5432) → DIRECT_URL
DATABASE_URL=""
DIRECT_URL=""
